<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function () {
  /* ── RENDERER SETUP ── */
  const canvas = document.getElementById('c');
  const W = window.innerWidth, H = window.innerHeight;
  const scene    = new THREE.Scene();
  const camera   = new THREE.PerspectiveCamera(60, W / H, 0.1, 100);
  camera.position.set(0, 0, 9);
  const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
  renderer.setSize(W, H);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));

  /* ── LIGHTS ── */
  scene.add(new THREE.AmbientLight(0xffffff, 0.25));
  const cL = new THREE.PointLight(0x00efd4, 3.5, 22); cL.position.set(6, 4, 4);  scene.add(cL);
  const vL = new THREE.PointLight(0x6c2ef5, 2.5, 18); vL.position.set(-5,-3, 3); scene.add(vL);
  const pL = new THREE.PointLight(0xff2d6d, 1.5, 14); pL.position.set(1, -6, 5); scene.add(pL);

  /* ── SHAPE FACTORY: solid (flat-shaded) + wireframe overlay ── */
  function makeShape(geo, solidCol, wireCol, solidOp, wireOp) {
    const grp = new THREE.Group();
    grp.add(new THREE.Mesh(geo, new THREE.MeshPhongMaterial({
      color: solidCol, transparent: true, opacity: solidOp,
      shininess: 110, flatShading: true,
      polygonOffset: true, polygonOffsetFactor: 1, polygonOffsetUnits: 1
    })));
    const wm = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({
      color: wireCol, wireframe: true, transparent: true, opacity: wireOp
    }));
    wm.scale.setScalar(1.004);
    grp.add(wm);
    return grp;
  }

  /* ── SHAPES ── */
  // 1. Large cyan icosahedron — hero, right
  const s1 = makeShape(new THREE.IcosahedronGeometry(2.3, 0), 0x00efd4, 0x00efd4, 0.07, 0.50);
  s1.position.set(5.8, 0.3, -1.5); scene.add(s1);

  // 2. Violet octahedron — left
  const s2 = makeShape(new THREE.OctahedronGeometry(1.7, 0), 0x6c2ef5, 0x8a55ff, 0.07, 0.45);
  s2.position.set(-5.8, 1.8, -2.5); scene.add(s2);

  // 3. Pink tetrahedron — lower right
  const s3 = makeShape(new THREE.TetrahedronGeometry(1.15, 0), 0xff2d6d, 0xff5090, 0.07, 0.42);
  s3.position.set(3.5, -4.8, 0.2); scene.add(s3);

  // 4. Small cyan icosahedron — upper left
  const s4 = makeShape(new THREE.IcosahedronGeometry(0.9, 0), 0x00ccff, 0x00ccff, 0.08, 0.50);
  s4.position.set(-4.2, 4.2, -1.2); scene.add(s4);

  // 5. Small cyan octahedron — lower left
  const s5 = makeShape(new THREE.OctahedronGeometry(1.05, 0), 0x00efd4, 0x00efd4, 0.06, 0.38);
  s5.position.set(-5.0, -4.0, -2.5); scene.add(s5);

  // 6. Ghost icosahedron — deep background, violet, very faint
  const g6 = new THREE.Mesh(
    new THREE.IcosahedronGeometry(5, 0),
    new THREE.MeshBasicMaterial({ color: 0x6c2ef5, wireframe: true, transparent: true, opacity: 0.05 })
  );
  g6.position.set(0, 0, -10); scene.add(g6);

  // 7. Ghost octahedron — right, far back
  const g7 = new THREE.Mesh(
    new THREE.OctahedronGeometry(3, 0),
    new THREE.MeshBasicMaterial({ color: 0x00efd4, wireframe: true, transparent: true, opacity: 0.04 })
  );
  g7.position.set(8, -2, -8); scene.add(g7);

  /* ── PARTICLE FIELD ── */
  const N   = window.innerWidth < 600 ? 80 : 140;
  const pos = new Float32Array(N * 3);
  for (let i = 0; i < N; i++) {
    pos[i * 3]     = (Math.random() - .5) * 26;
    pos[i * 3 + 1] = (Math.random() - .5) * 18;
    pos[i * 3 + 2] = (Math.random() - .5) * 10 - 2;
  }
  const pg = new THREE.BufferGeometry();
  pg.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  const pts = new THREE.Points(pg, new THREE.PointsMaterial({
    color: 0x00efd4, size: .04, transparent: true, opacity: .45
  }));
  scene.add(pts);

  /* ── MOUSE PARALLAX ── */
  let mx = 0, my = 0, tx = 0, ty = 0;
  document.addEventListener('mousemove', e => {
    mx = (e.clientX / window.innerWidth  - .5);
    my = -(e.clientY / window.innerHeight - .5);
    const g = document.getElementById('glow');
    if (g) { g.style.left = e.clientX + 'px'; g.style.top = e.clientY + 'px'; }
  });

  /* ── SCROLL ── */
  let scrollY = 0;
  window.addEventListener('scroll', () => { scrollY = window.scrollY; });

  /* ── ANIMATION LOOP ── */
  function animate(t) {
    requestAnimationFrame(animate);
    const T = t * .001;

    s1.rotation.x = T * .24;  s1.rotation.y = T * .17;
    s1.position.y = .3  + Math.sin(T * .58) * .42;

    s2.rotation.x = -T * .19; s2.rotation.z = T * .13;
    s2.position.y = 1.8 + Math.cos(T * .48) * .38;

    s3.rotation.y = T * .36;  s3.rotation.x = T * .24;
    s3.position.y = -4.8 + Math.sin(T * .78) * .28;

    s4.rotation.x = T * .42;  s4.rotation.z = -T * .28;
    s4.position.y = 4.2 + Math.cos(T * .66) * .28;

    s5.rotation.y = -T * .21; s5.rotation.x = T * .16;
    s5.position.y = -4.0 + Math.sin(T * .52) * .32;

    g6.rotation.y = T * .025; g6.rotation.x = T * .015;
    g7.rotation.z = T * .018; g7.rotation.y = T * .022;

    pts.rotation.y = T * .006;

    // Smooth camera parallax
    tx += (mx * .75 - tx) * .04;
    ty += (my * .50 - ty) * .04;
    camera.position.x = tx;
    camera.position.y = ty;
    camera.position.z = 9 - scrollY * .001;
    camera.lookAt(0, ty * .2, 0);

    renderer.render(scene, camera);
  }
  animate(0);

  /* ── RESIZE ── */
  window.addEventListener('resize', () => {
    const W2 = window.innerWidth, H2 = window.innerHeight;
    camera.aspect = W2 / H2;
    camera.updateProjectionMatrix();
    renderer.setSize(W2, H2);
  });
})();

