<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>דויד גלוזמן | שיווק דיגיטלי שעובד</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* ══════════════════════════════════════════
       VARIABLES & RESET
    ══════════════════════════════════════════ */
    :root {
      --bg:        #020a16;
      --cyan:      #00efd4;
      --cyan-dim:  #00bfaa;
      --violet:    #6c2ef5;
      --pink:      #ff2d6d;
      --white:     #e6f4ff;
      --text:      #7fb3cc;
      --text-dim:  #2d5068;
      --glass-bg:  rgba(3,12,28,.62);
      --glass-bd:  rgba(0,239,212,.12);
      --blur:      blur(22px);
      --r:         15px;
      --r-lg:      22px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Assistant', sans-serif;
      background: var(--bg);
      color: var(--text);
      direction: rtl;
      text-align: right;
      line-height: 1.7;
      font-size: 17px;
      overflow-x: hidden;
    }

    /* CSS grid background */
    body::before {
      content: '';
      position: fixed; inset: 0;
      background-image:
        linear-gradient(rgba(0,239,212,.022) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,239,212,.022) 1px, transparent 1px);
      background-size: 72px 72px;
      pointer-events: none; z-index: 0;
    }

    /* Cursor glow */
    #glow {
      position: fixed;
      width: 700px; height: 700px; border-radius: 50%;
      background: radial-gradient(circle, rgba(0,239,212,.045) 0%, transparent 65%);
      pointer-events: none; z-index: 0;
      transform: translate(-50%,-50%);
      transition: left .08s linear, top .08s linear;
    }

    /* Three.js canvas */
    #c {
      position: fixed; inset: 0;
      width: 100%; height: 100%;
      z-index: 1; pointer-events: none;
    }

    /* All content sits above canvas */
    nav, section, footer { position: relative; z-index: 2; }

    /* ══════════════════════════════════════════
       GLASS CARD
    ══════════════════════════════════════════ */
    .glass {
      background: var(--glass-bg);
      backdrop-filter: var(--blur);
      -webkit-backdrop-filter: var(--blur);
      border: 1px solid var(--glass-bd);
      border-radius: var(--r);
      position: relative; overflow: hidden;
      transition: border-color .25s, box-shadow .25s;
    }
    .glass::before {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(140deg, rgba(255,255,255,.04) 0%, transparent 55%);
      border-radius: inherit; pointer-events: none;
    }
    .glass:hover {
      border-color: rgba(0,239,212,.3);
      box-shadow: 0 0 32px rgba(0,239,212,.07), 0 20px 50px rgba(0,0,0,.5);
    }

    /* ══════════════════════════════════════════
       NAVIGATION
    ══════════════════════════════════════════ */
    nav {
      position: fixed; top: 0; right: 0; left: 0;
      z-index: 300; height: 66px; padding: 0 30px;
      display: flex; align-items: center; justify-content: space-between;
      background: rgba(2,8,20,.84);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-bottom: 1px solid rgba(0,239,212,.07);
    }
    .nav-logo {
      font-size: 1.1rem; font-weight: 800; color: var(--white);
      letter-spacing: -.5px; text-decoration: none;
    }
    .nav-logo em { font-style: normal; color: var(--cyan); }
    .nav-links { display: flex; gap: 28px; list-style: none; }
    .nav-links a {
      color: var(--text); text-decoration: none;
      font-size: .9rem; font-weight: 500; transition: color .2s;
    }
    .nav-links a:hover { color: var(--cyan); }
    .btn-nav {
      background: linear-gradient(135deg, var(--cyan), #00c8f0);
      color: #020a16; border: none; border-radius: 9px;
      padding: 9px 22px;
      font-family: 'Assistant', sans-serif;
      font-size: .9rem; font-weight: 800;
      cursor: pointer; text-decoration: none;
      box-shadow: 0 0 22px rgba(0,239,212,.2);
      transition: transform .2s, box-shadow .2s;
    }
    .btn-nav:hover { transform: translateY(-1px); box-shadow: 0 0 38px rgba(0,239,212,.38); }
    .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; }
    .hamburger span { display: block; width: 23px; height: 2px; background: var(--white); border-radius: 2px; }

    /* ══════════════════════════════════════════
       HERO
    ══════════════════════════════════════════ */
    #hero {
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 130px 30px 90px;
      position: relative; overflow: hidden;
    }

    /* Tron grid floor */
    .tron-floor {
      position: absolute;
      bottom: 0; left: -30%; right: -30%; height: 55%;
      background-image:
        linear-gradient(rgba(0,239,212,.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,239,212,.07) 1px, transparent 1px);
      background-size: 55px 55px;
      transform: perspective(450px) rotateX(62deg);
      transform-origin: bottom center;
      mask-image: linear-gradient(transparent 0%, rgba(0,0,0,.6) 50%, transparent 100%);
      -webkit-mask-image: linear-gradient(transparent 0%, rgba(0,0,0,.6) 50%, transparent 100%);
      pointer-events: none;
    }

    .hero-inner {
      position: relative; z-index: 1;
      max-width: 900px; margin: 0 auto; text-align: center;
    }

    .badge {
      display: inline-flex; align-items: center; gap: 10px;
      background: rgba(0,239,212,.07);
      border: 1px solid rgba(0,239,212,.22);
      border-radius: 50px; padding: 8px 22px;
      font-size: .78rem; font-weight: 700; letter-spacing: .5px;
      color: var(--cyan); margin-bottom: 32px;
    }
    .badge-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--cyan); box-shadow: 0 0 8px var(--cyan);
      animation: blink 2.2s infinite;
    }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }

    h1 {
      font-size: clamp(2.4rem, 6.5vw, 4.4rem);
      font-weight: 800; color: var(--white);
      line-height: 1.14; letter-spacing: -1.5px; margin-bottom: 26px;
    }
    h1 em {
      font-style: normal;
      background: linear-gradient(125deg, var(--cyan) 0%, #7c9fff 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text; position: relative;
    }
    /* Holographic scanline */
    h1 em::after {
      content: '';
      position: absolute; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent, rgba(0,239,212,.85), transparent);
      box-shadow: 0 0 8px rgba(0,239,212,.8);
      animation: scan 4s ease-in-out infinite;
    }
    @keyframes scan {
      0%   { top:0%;   opacity:0 }
      8%   { opacity:1 }
      92%  { opacity:1 }
      100% { top:100%; opacity:0 }
    }

    .hero-sub {
      font-size: clamp(1.05rem, 2.5vw, 1.22rem);
      color: var(--text); max-width: 600px;
      margin: 0 auto 46px; line-height: 1.8;
    }

    .hero-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

    .btn-primary {
      background: linear-gradient(135deg, var(--cyan), #00c0f5);
      color: #020a16; border: none; border-radius: var(--r);
      padding: 15px 36px;
      font-family: 'Assistant', sans-serif;
      font-size: 1.05rem; font-weight: 800;
      cursor: pointer; text-decoration: none;
      display: inline-flex; align-items: center; gap: 10px;
      box-shadow: 0 0 32px rgba(0,239,212,.2), 0 6px 24px rgba(0,0,0,.35);
      transition: transform .25s, box-shadow .25s;
    }
    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 0 56px rgba(0,239,212,.4), 0 10px 32px rgba(0,0,0,.45);
    }
    .btn-ghost {
      background: rgba(255,255,255,.04);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      color: var(--white);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: var(--r); padding: 14px 30px;
      font-family: 'Assistant', sans-serif;
      font-size: 1rem; font-weight: 600;
      cursor: pointer; text-decoration: none;
      transition: border-color .25s, color .25s, background .25s;
    }
    .btn-ghost:hover { border-color: var(--cyan); color: var(--cyan); background: rgba(0,239,212,.06); }

    .hero-stats {
      margin-top: 64px;
      display: inline-flex;
      background: rgba(3,12,28,.6);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(0,239,212,.1);
      border-radius: var(--r); overflow: hidden;
      flex-wrap: wrap;
    }
    .stat { padding: 20px 36px; text-align: center; border-left: 1px solid rgba(0,239,212,.1); }
    .stat:last-child { border-left: none; }
    .stat-n { font-size: 1.75rem; font-weight: 800; color: var(--white); line-height: 1; }
    .stat-n span { color: var(--cyan); }
    .stat-l { font-size: .78rem; color: var(--text-dim); margin-top: 5px; }

    /* ══════════════════════════════════════════
       SECTION BASE
    ══════════════════════════════════════════ */
    section { padding: 100px 30px; }
    .inner { max-width: 1080px; margin: 0 auto; }

    .stag {
      display: inline-flex; align-items: center; gap: 10px;
      font-size: .72rem; font-weight: 700; letter-spacing: 2.5px;
      text-transform: uppercase; color: var(--cyan); margin-bottom: 18px;
    }
    .stag::before { content:''; width:22px; height:1.5px; background:var(--cyan); display:block; }

    h2 {
      font-size: clamp(1.8rem, 4vw, 2.75rem);
      font-weight: 800; color: var(--white);
      line-height: 1.2; margin-bottom: 16px; letter-spacing: -.5px;
    }
    .lead {
      font-size: 1.08rem; color: var(--text);
      max-width: 570px; margin-bottom: 50px; line-height: 1.75;
    }

    /* ══════════════════════════════════════════
       FOR WHOM
    ══════════════════════════════════════════ */
    .fw-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 18px;
    }
    .fw-card { padding: 26px 22px; border-radius: var(--r); transition: transform .25s; }
    .fw-card:hover { transform: translateY(-5px); }
    .fw-icon { font-size: 1.8rem; margin-bottom: 13px; display: block; }
    .fw-card h3 { font-size: .98rem; font-weight: 700; color: var(--white); margin-bottom: 7px; }
    .fw-card p { font-size: .88rem; color: var(--text); line-height: 1.6; }

    /* ══════════════════════════════════════════
       SERVICES
    ══════════════════════════════════════════ */
    .svc-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 22px;
    }
    .svc-card { padding: 34px 28px; border-radius: var(--r-lg); transition: transform .3s; }
    .svc-card:hover { transform: translateY(-6px); }
    .svc-card::after {
      content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent, var(--cyan), transparent);
      opacity: 0; transition: opacity .3s; border-radius: 0 0 var(--r-lg) var(--r-lg);
    }
    .svc-card:hover::after { opacity: 1; }
    .svc-num { font-size:.68rem; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--cyan); margin-bottom:12px; display:block; }
    .svc-ico { font-size: 1.9rem; margin-bottom: 15px; display: block; }
    .svc-card h3 { font-size: 1.08rem; font-weight: 700; color: var(--white); margin-bottom: 10px; }
    .svc-card p { font-size: .9rem; color: var(--text); line-height: 1.65; }

    /* ══════════════════════════════════════════
       WHY ME
    ══════════════════════════════════════════ */
    .whyme-layout {
      display: grid; grid-template-columns: 1.05fr .95fr;
      gap: 50px; align-items: start;
    }
    .why-list { list-style: none; display: flex; flex-direction: column; gap: 16px; margin-top: 28px; }
    .why-item {
      display: flex; gap: 16px; padding: 18px 20px; border-radius: var(--r);
      transition: transform .2s;
    }
    .why-item:hover { transform: translateX(-4px); }
    .check {
      flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%;
      background: rgba(0,239,212,.09); border: 1px solid rgba(0,239,212,.28);
      display: flex; align-items: center; justify-content: center;
      color: var(--cyan); font-size: .72rem; margin-top: 3px;
      box-shadow: 0 0 10px rgba(0,239,212,.12);
    }
    .why-item strong { color: var(--white); font-size: .98rem; display: block; margin-bottom: 3px; }
    .why-item span { color: var(--text); font-size: .88rem; }

    .quote-panel { padding: 34px 28px; border-radius: var(--r-lg); }
    .qt {
      font-size: 1.05rem; color: var(--white); font-weight: 500;
      line-height: 1.72; padding-right: 22px; position: relative; margin-bottom: 18px;
    }
    .qt::before {
      content: ''; position: absolute; right: 0; top: 4px; bottom: 4px;
      width: 3px; background: linear-gradient(180deg, var(--cyan), var(--violet)); border-radius: 2px;
    }
    .qa { font-size: .83rem; color: var(--text-dim); margin-bottom: 28px; }
    .chips { display: flex; flex-wrap: wrap; gap: 9px; }
    .chip {
      background: rgba(0,239,212,.06); border: 1px solid rgba(0,239,212,.16);
      border-radius: 50px; padding: 5px 15px;
      font-size: .82rem; color: var(--cyan); font-weight: 600;
    }

    /* ══════════════════════════════════════════
       PROCESS
    ══════════════════════════════════════════ */
    .process-wrap {
      display: flex; flex-direction: column; gap: 14px;
      max-width: 760px; position: relative;
    }
    .process-wrap::before {
      content: ''; position: absolute; right: 23px; top: 23px; bottom: 23px; width: 1px;
      background: linear-gradient(180deg, var(--cyan), var(--violet), transparent);
      opacity: .25;
    }
    .p-step {
      display: flex; gap: 24px; align-items: flex-start;
      padding: 24px 26px; border-radius: var(--r); transition: transform .2s;
    }
    .p-step:hover { transform: translateX(-5px); }
    .p-num {
      flex-shrink: 0; width: 46px; height: 46px; border-radius: 50%;
      background: rgba(0,239,212,.08); border: 1.5px solid rgba(0,239,212,.32);
      display: flex; align-items: center; justify-content: center;
      font-size: .88rem; font-weight: 800; color: var(--cyan);
      box-shadow: 0 0 14px rgba(0,239,212,.11);
    }
    .p-step h3 { font-size: 1rem; font-weight: 700; color: var(--white); margin-bottom: 4px; }
    .p-step p { font-size: .88rem; color: var(--text); }

    /* ══════════════════════════════════════════
       FAQ
    ══════════════════════════════════════════ */
    .faq-list { max-width: 790px; display: flex; flex-direction: column; gap: 13px; }
    .fi { border-radius: var(--r); overflow: hidden; }
    .fq {
      padding: 20px 24px; font-size: .98rem; font-weight: 700; color: var(--white);
      cursor: pointer; display: flex; justify-content: space-between; align-items: center;
      gap: 16px; user-select: none; transition: color .2s;
    }
    .fq:hover { color: var(--cyan); }
    .farrow {
      flex-shrink: 0; color: var(--cyan); width: 22px; height: 22px; border-radius: 50%;
      border: 1px solid rgba(0,239,212,.28);
      display: flex; align-items: center; justify-content: center;
      font-size: .82rem; transition: transform .3s, background .2s;
    }
    .fi.open .farrow { transform: rotate(180deg); background: rgba(0,239,212,.1); }
    .fa {
      max-height: 0; overflow: hidden;
      transition: max-height .4s ease, padding .3s;
      padding: 0 24px; color: var(--text); font-size: .93rem; line-height: 1.72;
    }
    .fi.open .fa { max-height: 300px; padding: 0 24px 22px; }

    /* ══════════════════════════════════════════
       CTA FINAL
    ══════════════════════════════════════════ */
    #cta { padding: 120px 30px; text-align: center; position: relative; }
    #cta::before {
      content: ''; position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 50% 50% at 30% 40%, rgba(108,46,245,.08), transparent 70%),
        radial-gradient(ellipse 50% 50% at 70% 60%, rgba(0,239,212,.06), transparent 70%);
      pointer-events: none;
    }
    .cta-box {
      max-width: 720px; margin: 0 auto;
      padding: 64px 56px; border-radius: 28px; position: relative;
    }
    .cta-box::after {
      content: ''; position: absolute; inset: -1px;
      border-radius: 29px;
      background: linear-gradient(135deg, var(--cyan), var(--violet), var(--pink));
      z-index: -1; opacity: .3;
    }
    #cta h2 { margin-bottom: 18px; }
    #cta p { color: var(--text); font-size: 1.05rem; max-width: 480px; margin: 0 auto 44px; line-height: 1.75; }

    /* ══════════════════════════════════════════
       FOOTER
    ══════════════════════════════════════════ */
    footer {
      background: rgba(2,7,17,.97);
      border-top: 1px solid rgba(0,239,212,.06);
      padding: 34px 30px; text-align: center;
      color: var(--text-dim); font-size: .86rem;
    }
    footer a { color: var(--text); text-decoration: none; }
    footer a:hover { color: var(--cyan); }

    /* ══════════════════════════════════════════
       SCROLL REVEAL
    ══════════════════════════════════════════ */
    .fi-anim { opacity: 0; transform: translateY(28px); transition: opacity .65s ease, transform .65s ease; }
    .fi-anim.vis { opacity: 1; transform: translateY(0); }
    .stagger .fi-anim:nth-child(1){transition-delay:.00s}
    .stagger .fi-anim:nth-child(2){transition-delay:.08s}
    .stagger .fi-anim:nth-child(3){transition-delay:.16s}
    .stagger .fi-anim:nth-child(4){transition-delay:.24s}
    .stagger .fi-anim:nth-child(5){transition-delay:.32s}
    .stagger .fi-anim:nth-child(6){transition-delay:.40s}

    /* ══════════════════════════════════════════
       RESPONSIVE
    ══════════════════════════════════════════ */
    @media (max-width: 820px) {
      .nav-links { display: none; }
      .hamburger { display: flex; }
      .nav-links.open {
        display: flex; flex-direction: column;
        position: fixed; top: 66px; right: 0; left: 0;
        background: rgba(2,8,20,.97);
        backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
        border-bottom: 1px solid rgba(0,239,212,.1);
        padding: 28px 30px; gap: 20px; z-index: 299;
      }
      section { padding: 80px 22px; }
      .whyme-layout { grid-template-columns: 1fr; gap: 32px; }
      .stat { border-left: none; border-bottom: 1px solid rgba(0,239,212,.1); }
      .stat:last-child { border-bottom: none; }
      .hero-stats { flex-direction: column; }
    }
    @media (max-width: 540px) {
      h1 { font-size: 2.1rem; letter-spacing: -.5px; }
      .svc-grid, .fw-grid { grid-template-columns: 1fr; }
      .cta-box { padding: 42px 26px; }
    }
  </style>
</head>
<body>

<canvas id="c"></canvas>
<div id="glow"></div>

<!-- ═══════════════════ NAV ═══════════════════ -->
<nav>
  <a href="#hero" class="nav-logo">דויד <em>גלוזמן</em></a>
  <ul class="nav-links" id="nl">
    <li><a href="#forwhom"  onclick="cn()">למי זה מתאים</a></li>
    <li><a href="#services" onclick="cn()">שירותים</a></li>
    <li><a href="#whyme"    onclick="cn()">למה אני</a></li>
    <li><a href="#process"  onclick="cn()">תהליך</a></li>
    <li><a href="#faq"      onclick="cn()">שאלות</a></li>
  </ul>
  <div style="display:flex;align-items:center;gap:12px">
    <a href="https://wa.me/972XXXXXXXXX" class="btn-nav" target="_blank">דברו איתי</a>
    <div class="hamburger" id="hb" onclick="tn()">
      <span></span><span></span><span></span>
    </div>
  </div>
</nav>

<!-- ═══════════════════ HERO ═══════════════════ -->
<section id="hero">
  <div class="tron-floor"></div>
  <div class="hero-inner">
    <div class="badge"><div class="badge-dot"></div>שיווק דיגיטלי · קמפיינים · אוטומציות</div>

    <h1>השיווק שלך <em>לא חייב</em><br>להרגיש מבולגן</h1>

    <p class="hero-sub">
      אני עוזר לבעלי עסקים לבנות מערכת שיווק ברורה —
      מהמסר ועד הלקוח. בלי בלבול, בלי ניחושים, עם תוצאות אמיתיות.
    </p>

    <div class="hero-btns">
      <a href="https://wa.me/972XXXXXXXXX" class="btn-primary" target="_blank">💬 בואו נעשה סדר בשיווק שלכם</a>
      <a href="#services" class="btn-ghost">מה אני עושה ←</a>
    </div>

    <div class="hero-stats">
      <div class="stat">
        <div class="stat-n">8<span>+</span></div>
        <div class="stat-l">שנות ניסיון</div>
      </div>
      <div class="stat">
        <div class="stat-n">100<span>+</span></div>
        <div class="stat-l">עסקים שקיבלו ליווי</div>
      </div>
      <div class="stat">
        <div class="stat-n">3</div>
        <div class="stat-l">עולמות: תוכנה · שיווק · תוכן</div>
      </div>
    </div>
